# Copiar a .env y completar.

# Postgres. Local rapido: docker compose up -d (ver README).
DATABASE_URL="postgresql://postgres:root@localhost:5432/ladrilleraspitalito?schema=public"

# Puerto del backend. El frontend apunta a http://localhost:8080/api.
PORT=8080

# Origenes permitidos por CORS, separados por coma.
CORS_ORIGIN="http://localhost:3000"

# Firma de los JWT. Cambiar en cualquier entorno que no sea local.
JWT_SECRET="dev-secret-cambiar"
JWT_EXPIRES_IN="1d"
