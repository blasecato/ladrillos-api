# Copiar a .env y completar.

# Postgres. Local rapido: docker compose up -d (ver README).
DATABASE_URL="postgresql://postgres:root@localhost:5432/ladrilleraspitalito?schema=public"

# Conexion DIRECTA a Postgres, solo para el CLI de Prisma (migrate/introspect).
# Con un pooler delante (Supabase, Neon, PgBouncer), `DATABASE_URL` apunta al
# pooler y esta al puerto directo. En local no hace falta: si se omite, el CLI
# usa `DATABASE_URL`.
# DIRECT_URL="postgresql://usuario:clave@host:5432/basedatos"

# Puerto del backend. El frontend apunta a http://localhost:8080/api.
PORT=8080

# Origenes permitidos por CORS, separados por coma.
CORS_ORIGIN="http://localhost:3000"

# Firma de los JWT. Cambiar en cualquier entorno que no sea local.
JWT_SECRET="dev-secret-cambiar"
JWT_EXPIRES_IN="1d"
